# 千问 API Key（DashScope兼容OpenAI接口）
# 首次部署后请在 Railway Dashboard 中设置此环境变量
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 模型配置
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# 存储路径
UPLOAD_DIR=./uploads
DATA_DIR=./data
SQLITE_DB=./data/lesson_prep.db

# 生成参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
